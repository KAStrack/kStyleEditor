{
  "name": "@kastrack/style-editor",
  "version": "0.1.2",
  "description": "A zero-dependency visual CSS editor that takes over a <textarea>, plus server-side SDKs that sanitise the CSS it writes.",
  "keywords": [
    "css",
    "style-editor",
    "visual-editor",
    "form-builder",
    "textarea",
    "sanitize",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "Ben",
  "homepage": "https://kastrack.github.io/kStyleEditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KAStrack/kStyleEditor.git"
  },
  "bugs": {
    "url": "https://github.com/KAStrack/kStyleEditor/issues"
  },
  "main": "src/k-style-css.js",
  "browser": "src/k-style-editor.js",
  "exports": {
    ".": "./src/k-style-css.js",
    "./css": "./src/k-style-css.js",
    "./editor": "./src/k-style-editor.js",
    "./editor.css": "./src/k-style-editor.css",
    "./bundle": "./dist/k-style.min.js",
    "./bundle.css": "./dist/k-style.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node --test \"tests/js/*.test.js\"",
    "test:php": "php tests/php/conformance.php",
    "test:python": "cd sdk/python && python3 -m unittest discover -s tests",
    "test:all": "npm test && npm run test:php && npm run test:python && npm run test:browser",
    "preserve": "npm run build",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const t=p.join(process.cwd(),'docs',u);f.readFile(t,(e,d)=>{if(e){s.writeHead(404);return s.end('not found');}const x={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml'}[p.extname(t)]||'text/plain';s.writeHead(200,{'content-type':x});s.end(d);});}).listen(8080,()=>console.log('http://localhost:8080/'))\"",
    "prepublishOnly": "npm run build && npm test",
    "pretest:browser": "npm run build",
    "test:browser": "node tests/browser/run.js"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "clean-css": "^5.3.3",
    "playwright": "^1.56.0",
    "terser": "^5.31.0"
  }
}
